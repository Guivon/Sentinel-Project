# --- Supabase (obrigatório) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SALVAR_TEXTO=0

# --- IA ---
# "bedrock" (padrão, aceita texto, imagem e PDF) ou "anthropic" (só texto)
PROVEDOR_IA=bedrock
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Fora da AWS (ex.: Render), use as chaves de um usuário IAM que só tenha bedrock:InvokeModel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Só se PROVEDOR_IA=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Opcionais ---
# Máximo de análises por usuário a cada janela (padrão: 30 por 60 segundos)
LIMITE_ANALISES=30
LIMITE_JANELA_S=60
LIMITE_ARQUIVO_BYTES=4000000
LOG_LEVEL=INFO
# 1 grava o texto das mensagens nos logs. Use só para investigar um problema.
DEBUG_LOG=0
